# Daniela Beauty — variáveis de ambiente. COPIAR para `.env` e preencher.
# NUNCA commitar o `.env` (está no .gitignore). Nenhum valor aqui é real.

# --- Identidade do negócio ------------------------------------------------
BUSINESS_NAME="Daniela Beauty"
BUSINESS_ADDRESS=""

# --- WhatsApp Cloud API (Meta) — OBRIGATÓRIO para o bot -------------------
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=
# Número (formato internacional, só dígitos) que recebe as notificações internas.
PROVIDER_WHATSAPP=
# App Secret da app Meta — valida a assinatura X-Hub-Signature-256 dos webhooks.
# Sem ele, a verificação de assinatura fica em modo aviso (só para dev).
APP_SECRET=
# GRAPH_API_VERSION=v21.0

# --- Painel / dashboard (HTTP Basic) — OBRIGATÓRIO para o painel ---------
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- Base de dados ------------------------------------------------------
# Esta versão corre SEMPRE sobre SQLite. Deixar VAZIO. Se for preenchido com
# um URL de Postgres, db.py aborta de propósito (backend Postgres ainda não
# implementado — ver MIGRATION.md).
DATABASE_URL=
# Caminho do SQLite local (dev). Em produção com disco persistente no Render,
# apontar para dentro do disco montado, ex.: /var/data/sessoes.db
SESSOES_DB=sessoes.db

# --- Outros -----------------------------------------------------------
# URL pública do serviço (para links no painel). Opcional.
PUBLIC_BASE_URL=
# Pasta local das fotografias de pedidos legados. Opcional.
MEDIA_DIR=media_pedidos
# Minutos que um horário fica retido enquanto o cliente confirma.
RESERVA_TEMPORARIA_MINUTOS=15
# Ligar aprovação manual das marcações (entram como "pending"). Por agora: false.
BOOKING_REQUIRES_APPROVAL=false
# Seed DEMO temporário (/api/dev/seed-dashboard) — DESLIGADO por omissão.
# Só ligar num ambiente de demonstração, nunca com clientes reais.
ENABLE_DEMO_SEED=false
